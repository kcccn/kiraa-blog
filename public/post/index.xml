<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>所有post - Kiraa</title><link>https://kiraa-blog.vercel.app/post/</link><description>Kiraa</description><generator>Hugo 0.154.5 &amp; FixIt v0.4.3-20260123080729-2a5bd268</generator><language>zh-cn</language><lastBuildDate>Fri, 13 Feb 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://kiraa-blog.vercel.app/post/index.xml" rel="self" type="application/rss+xml"/><item><title>HSTU Embedding 学习笔记</title><link>https://kiraa-blog.vercel.app/post/learning-torchrec/hstu-embedding/</link><pubDate>Fri, 13 Feb 2026 00:00:00 +0000</pubDate><guid>https://kiraa-blog.vercel.app/post/learning-torchrec/hstu-embedding/</guid><description>&lt;h2 class="heading-element" id="torchrec"&gt;&lt;span&gt;Torchrec&lt;/span&gt;
