&lt;/h3&gt;&lt;h4 class="heading-element" id="jaggedtensor-jt"&gt;&lt;span&gt;&lt;a href="https://meta-pytorch.org/torchrec/datatypes-api-reference.html#torchrec.sparse.jagged_tensor.JaggedTensor" target="_blank" rel="external nofollow noopener noreferrer"&gt;&lt;code&gt;JaggedTensor&lt;/code&gt;&lt;/a&gt; (&lt;code&gt;jt&lt;/code&gt;)&lt;/span&gt;
